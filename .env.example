# Optional: use your own API key to enable AI synthesis.
# Keep real keys in .env; never commit secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Open-source local voice models (no paid voice API required)
WHISPER_MODEL=base
# Set this to the full path of a downloaded Piper .onnx voice model
PIPER_VOICE_MODEL=
# Usually "piper" after installing piper-tts
PIPER_EXECUTABLE=piper
